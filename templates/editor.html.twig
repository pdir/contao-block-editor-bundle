<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>Block-Editor: {{ title }}</title>
    <link rel="stylesheet" href="{{ assets.shell_css }}">
    {# The bars of the rich text editor, which the inspector shares with the page #}
    <link rel="stylesheet" href="{{ assets.frame_css }}">
    {% if frame_url is defined %}
        {# Classic and blocking on purpose: the stored width and inspector apply before the first paint #}
        <script src="{{ assets.restore_settings_js }}"></script>
        <link rel="modulepreload" href="{{ assets.frame_js }}">
        {% for script in extension_scripts %}
            <script type="module" src="{{ script }}"></script>
        {% endfor %}
        <script type="module" src="{{ assets.shell_js }}"></script>
    {% endif %}
</head>
<body>
    {% if frame_url is defined %}
        <div id="cbe-app"
             data-token="{{ token }}"
             data-api="{{ path('pdir_block_editor_api_elements') }}"
             data-schema="{{ path('pdir_block_editor_api_schema') }}"
             data-base="{{ app.request.basePath }}"
             data-preview="{{ preview_url }}"
             data-backend="{{ path('contao_backend') }}"
             data-picker="{{ path('contao_backend_picker') }}"
             data-rich-editor="{{ assets.rich_editor_js }}"
             data-preview-menu="{{ assets.preview_menu_js }}"
             data-pages="{{ path('pdir_block_editor_api_pages') }}"
             data-nav-pages="{{ assets.nav_pages_js }}"
             data-records="{{ path('pdir_block_editor_api_pages')|replace({'/pages': '/records'}) }}"
             data-reader-record="{{ assets.reader_record_js }}"
             data-inserter="{{ assets.inserter_js }}"
             data-table-field="{{ assets.table_field_js }}"
             data-undo="{{ path('pdir_block_editor_api_pages')|replace({'/pages': '/undo'}) }}">
            <header class="cbe-bar">
                <button id="cbe-back" class="cbe-link cbe-back" type="button" hidden>Zurück</button>
                <div class="cbe-doc">
                    <img class="cbe-logo" src="{{ app.request.basePath }}/bundles/contaoblockeditor/icon.svg" width="16" height="16" alt="">
                    <strong id="cbe-title" class="cbe-title">{{ title }}</strong>
                    <div class="cbe-status-line">
                        <span id="cbe-status" class="cbe-status" role="status" aria-live="polite"></span>
                        <button id="cbe-undo" class="cbe-link cbe-undo" type="button" hidden>Rückgängig</button>
                    </div>
                </div>
                <button id="cbe-edit-toggle" class="cbe-icon-button" type="button" aria-pressed="true" aria-label="Bearbeiten" title="Bearbeiten ein- oder ausschalten (E)">
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M10.5 2.5 13.5 5.5 5.5 13.5H2.5V10.5Z"/><path d="m8.5 4.5 3 3"/></svg>
                </button>
                {% set options = preview_options %}
                <div class="cbe-preview">
                    <button id="cbe-preview-toggle" class="cbe-icon-button" type="button" aria-expanded="false" aria-controls="cbe-preview-menu" aria-label="Vorschau" title="Vorschau: Adresse, Mitglied, nicht veröffentlichte Elemente"{% if options.member or options.show_unpublished %} data-active{% endif %}>
                        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1.5 8S4 3.25 8 3.25 14.5 8 14.5 8 12 12.75 8 12.75 1.5 8 1.5 8Z"/><circle cx="8" cy="8" r="2.25"/></svg>
                    </button>
                    <form id="cbe-preview-menu" class="cbe-preview__menu" aria-label="Vorschau" data-switch="{{ options.switch_url }}" data-share="{{ options.share_url }}" hidden>
                        <div class="cbe-preview__actions">
                            <button class="cbe-button" type="button" data-preview-copy>URL kopieren</button>
                            {% if options.share_url %}
                                <button class="cbe-button" type="button" data-preview-share>URL teilen</button>
                            {% endif %}
                        </div>
                        {% if options.can_switch_member %}
                            <div class="cbe-field">
                                <label for="cbe-preview-member">Mitglied</label>
                                <div class="cbe-preview__member">
                                    <input id="cbe-preview-member" type="text" name="user" list="cbe-preview-members" placeholder="Benutzername" value="{{ options.member }}" autocomplete="off" spellcheck="false" aria-describedby="cbe-preview-message">
                                    <button class="cbe-button" type="submit">Anwenden</button>
                                </div>
                                <datalist id="cbe-preview-members"></datalist>
                                <p class="cbe-description">Zeigt die Seite, wie das Mitglied sie sieht. Leer lassen für Gäste.</p>
                            </div>
                        {% endif %}
                        <div class="cbe-field cbe-field--switch">
                            <label for="cbe-preview-unpublished">Nicht veröffentlichte Elemente anzeigen</label>
                            <input id="cbe-preview-unpublished" type="checkbox" name="unpublished" value="show"{% if options.show_unpublished %} checked{% endif %}>
                        </div>
                        <p id="cbe-preview-message" class="cbe-preview__message" role="status" aria-live="polite"></p>
                    </form>
                </div>
                <div class="cbe-viewports" role="group" aria-label="Vorschaubreite">
                    <button class="cbe-viewport" type="button" data-viewport="desktop" aria-pressed="true" title="Volle Breite">Desktop</button>
                    <button class="cbe-viewport" type="button" data-viewport="tablet" aria-pressed="false" title="768 Pixel breit">Tablet</button>
                    <button class="cbe-viewport" type="button" data-viewport="mobile" aria-pressed="false" title="375 Pixel breit">Mobil</button>
                </div>
                <button id="cbe-inspector-toggle" class="cbe-icon-button" type="button" aria-pressed="true" aria-controls="cbe-inspector" aria-label="Inspector" title="Inspector ein- oder ausblenden">
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="1.75" y="2.75" width="12.5" height="10.5" rx="1.5"/><path d="M10 2.75v10.5"/></svg>
                </button>
                <a class="cbe-link" href="{{ path('contao_backend', {do: 'page'}) }}">Zum Backend</a>
            </header>
            <main class="cbe-main">
                <iframe id="cbe-frame" class="cbe-frame" src="{{ frame_url }}" title="Seitenvorschau: {{ title }}"></iframe>
                <aside id="cbe-inspector" class="cbe-inspector" aria-label="Eigenschaften des Elements">
                    <p class="cbe-hint">Klicke auf ein Element, um es zu bearbeiten.</p>
                </aside>
                <template id="cbe-help">
                    <p class="cbe-hint">Klicke auf ein Element, um es zu bearbeiten.</p>
                    <div class="cbe-viewing">
                        <p class="cbe-hint">Bearbeiten ist aus. Links führen zu ihrer Seite.</p>
                        <p class="cbe-description">Wieder einschalten mit dem Stift oben oder der Taste <kbd>E</kbd>.</p>
                    </div>
                    <section class="cbe-page-meta" aria-label="Angaben der Seite für Suchmaschinen"></section>
                    <section class="cbe-help" aria-labelledby="cbe-help-title">
                        <h2 id="cbe-help-title">So funktioniert der Editor</h2>
                        <dl>
                            <dt>Text</dt>
                            <dd>Reinklicken und tippen, <kbd>Esc</kbd> beendet.</dd>
                            <dt>Verschieben</dt>
                            <dd>Griff <span class="cbe-help-handle" aria-hidden="true"><svg viewBox="0 0 8 12" width="8" height="12" fill="currentColor"><circle cx="2" cy="2" r="1.1"/><circle cx="6" cy="2" r="1.1"/><circle cx="2" cy="6" r="1.1"/><circle cx="6" cy="6" r="1.1"/><circle cx="2" cy="10" r="1.1"/><circle cx="6" cy="10" r="1.1"/></svg></span> ziehen oder <kbd data-key="alt">Alt</kbd> + <kbd>↑</kbd>/<kbd>↓</kbd>.</dd>
                            <dt>Neues Element</dt>
                            <dd>Plus unter dem Griff oder „Element darunter einfügen“ im Inspector.</dd>
                            <dt>Links</dt>
                            <dd>Klick im Text: <em>Öffnen</em> oder <em>Bearbeiten</em>. Neu: Text markieren, <kbd data-key="mod">Strg</kbd> + <kbd>K</kbd>.</dd>
                            <dt>Seite wechseln</dt>
                            <dd>Link in der Navigation anklicken.</dd>
                        </dl>
                        <details class="cbe-help-more">
                            <summary>Mehr erfahren</summary>
                            <dl>
                                <dt>Speichern</dt>
                                <dd>Änderungen werden automatisch gespeichert, auch vor jedem Seitenwechsel. Den Stand zeigt die obere Leiste.</dd>
                                <dt>Eigenschaften</dt>
                                <dd>Nach dem Klick auf ein Element stehen seine Einstellungen hier in der Seitenleiste.</dd>
                                <dt>Insert-Tags</dt>
                                <dd>Beim Bearbeiten siehst du den Tag, zum Beispiel <code>{{ '{{email::…}}' }}</code>, danach wieder das Ergebnis.</dd>
                                <dt>Klassisches Backend</dt>
                                <dd>Was hier noch nicht geht, erreichst du über „Im klassischen Backend bearbeiten“ beim ausgewählten Element.</dd>
                            </dl>
                            <div class="cbe-help-settings">
                                <div class="cbe-field cbe-field--switch">
                                    <label for="cbe-setting-corners">Abgerundete Ecken</label>
                                    <input id="cbe-setting-corners" type="checkbox" data-setting="corners">
                                </div>
                                <div class="cbe-field cbe-field--switch">
                                    <label for="cbe-setting-nav-edit">Navigationslinks bearbeiten</label>
                                    <input id="cbe-setting-nav-edit" type="checkbox" data-setting="nav-edit" aria-describedby="cbe-setting-nav-edit-hint">
                                    <p id="cbe-setting-nav-edit-hint" class="cbe-description">Ein Klick auf einen Menüpunkt ändert den Seitennamen. Geöffnet wird die Seite dann über die Leiste am Link. Taste <kbd>N</kbd></p>
                                </div>
                            </div>
                        </details>
                        <details id="cbe-shortcuts" class="cbe-help-more">
                            <summary>Globale Tastaturbefehle</summary>
                            <dl>
                                <dt>Bearbeiten ein/aus</dt>
                                <dd><kbd>E</kbd> schaltet ein und aus. Ausgeschaltet führt jeder Link zu seiner Seite.</dd>
                                <dt>Inspector ein/aus</dt>
                                <dd><kbd>I</kbd> oder <kbd data-key="mod">Strg</kbd> + <kbd data-key="shift">Umschalt</kbd> + <kbd>,</kbd>, das geht auch beim Schreiben.</dd>
                                <dt>Navigationslinks bearbeiten</dt>
                                <dd><kbd>N</kbd> schaltet ein und aus.</dd>
                                <dt>Vorschaubreite</dt>
                                <dd><kbd>1</kbd> Desktop, <kbd>2</kbd> Tablet, <kbd>3</kbd> Mobil.</dd>
                                <dt>Diese Übersicht</dt>
                                <dd><kbd>?</kbd></dd>
                                <dt>Im Text</dt>
                                <dd><kbd data-key="mod">Strg</kbd> + <kbd>B</kbd> fett, <kbd data-key="mod">Strg</kbd> + <kbd>I</kbd> kursiv, <kbd data-key="mod">Strg</kbd> + <kbd>K</kbd> Link, <kbd>Esc</kbd> beendet.</dd>
                            </dl>
                            <p>Einzelne Tasten wirken nur, wenn gerade kein Text bearbeitet wird. Browser-Kürzel bleiben unberührt.</p>
                            <div class="cbe-help-settings">
                                <div class="cbe-field cbe-field--switch">
                                    <label for="cbe-setting-single-keys">Befehle mit einzelnen Tasten</label>
                                    <input id="cbe-setting-single-keys" type="checkbox" data-setting="single-keys" aria-describedby="cbe-setting-single-keys-hint">
                                    <p id="cbe-setting-single-keys-hint" class="cbe-description">Für Screenreader ausschalten, die einzelne Tasten selbst nutzen.</p>
                                </div>
                            </div>
                        </details>
                    </section>
                </template>
            </main>
            <dialog id="cbe-picker" class="cbe-picker" aria-labelledby="cbe-picker-title">
                <h2 id="cbe-picker-title">Link auswählen</h2>
                <iframe class="cbe-picker__frame" title="Seiten, Dateien und weitere Ziele"></iframe>
                <div class="cbe-picker__actions">
                    <button class="cbe-button" type="button" data-picker-cancel>Abbrechen</button>
                    <button class="cbe-button cbe-button--primary" type="button" data-picker-apply>Übernehmen</button>
                </div>
            </dialog>
            <dialog id="cbe-inserter" class="cbe-picker cbe-inserter" aria-labelledby="cbe-inserter-title">
                <h2 id="cbe-inserter-title">Element einfügen</h2>
                <div class="cbe-field">
                    <label for="cbe-inserter-search">Elementtyp suchen</label>
                    <input id="cbe-inserter-search" type="search" autocomplete="off" spellcheck="false" aria-describedby="cbe-inserter-message">
                </div>
                <div class="cbe-inserter__list"></div>
                <p id="cbe-inserter-message" class="cbe-inserter__message" role="status"></p>
                <div class="cbe-picker__actions">
                    <button class="cbe-button" type="button" data-inserter-cancel>Abbrechen</button>
                </div>
            </dialog>
        </div>
    {% else %}
        <main class="cbe-notice">
            <h1>{{ title }}</h1>
            {% if stale_assets is defined %}
                <p>Die veröffentlichten Editor-Dateien passen nicht zur installierten Version des Bundles. Der Editor bleibt deshalb geschlossen, damit keine Inhalte beschädigt werden.</p>
                <p>Bitte <code>vendor/bin/contao-console assets:install public --symlink</code> ausführen (ohne Managed Edition: <code>bin/console</code>) und die Seite neu laden.</p>
            {% elseif other_domain_url is defined %}
                <p>Diese Seite liegt auf einer anderen Domain und kann nur dort bearbeitet werden.</p>
                <p><a href="{{ other_domain_url }}">Editor auf der Domain der Seite öffnen</a></p>
            {% else %}
                <p>Der Block-Editor benötigt das Vorschau-Skript von Contao (<code>contao.preview_script</code>).</p>
            {% endif %}
            <p><a href="{{ path('contao_backend', {do: 'page'}) }}">Zum Backend</a></p>
        </main>
    {% endif %}
</body>
</html>
